# DispatchBox — Frontend Environment Variables
# ─────────────────────────────────────────────
# Copy this file to .env.local for local development,
# or use .env.production / .env.staging for deployment builds.
#
# Vite loads env files based on --mode flag:
#   npx vite build --mode staging     → .env.staging
#   npx vite build --mode production  → .env.production
#   npx vite dev                      → .env.local (if it exists)

# Firebase Configuration
# Get these from Firebase Console → Project Settings → Your Apps → Web
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# OpenWeatherMap API Key
# Get a free key at https://openweathermap.org/api
# Required for real weather data in the dashboard
VITE_OPENWEATHER_API_KEY=your_api_key_here

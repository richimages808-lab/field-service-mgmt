rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // =============================================================================
    // HELPER FUNCTIONS
    // =============================================================================

    function isSignedIn() {
      return request.auth != null;
    }
    
    function getRole() {
      return request.auth.token.role;
    }
    
    function getOrgId() {
      return request.auth.token.org_id;
    }
    
    function getCustomerId() {
      // For customer portal users
      return request.auth.token.customer_id;
    }
    
    function isStaff() {
      return isSignedIn() && getRole() in ['owner', 'admin', 'dispatcher', 'technician'];
    }
    
    function isCustomer() {
      return getRole() == 'customer';
    }

    function isOwner() {
      return getRole() == 'owner';
    }
    
    function isAdmin() {
      return getRole() in ['owner', 'admin'];
    }

    function isDispatcher() {
      return isSignedIn() && getRole() in ['owner', 'admin', 'dispatcher'];
    }

    function isTechnician() {
      return getRole() == 'technician';
    }

    function getUserProfile() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function hasPermission(permissionName) {
      // Admins and dispatchers bypass these checks.
      return isAdmin() || isDispatcher() || 
             getUserProfile().get(['permissions', permissionName], true) == true;
    }

    // Check if the user belongs to the organization
    function belongsToOrg(orgId) {
      return isSignedIn() && string(getOrgId()) == string(orgId);
    }
    
    // Check if document belongs to user's org (uses 'org_id' field)
    function docBelongsToUserOrg() {
      return belongsToOrg(resource.data.org_id);
    }
    
    // Check if new document has correct org_id
    function newDocHasUserOrg() {
      return belongsToOrg(request.resource.data.org_id);
    }

    // Check if document belongs to user's org (uses 'organizationId' field)
    // Some collections use this field name instead of 'org_id'
    function docBelongsToUserOrgAlt() {
      return belongsToOrg(resource.data.organizationId);
    }

    // Check if new document has correct organizationId
    function newDocHasUserOrgAlt() {
      return belongsToOrg(request.resource.data.organizationId);
    }

    // =============================================================================
    // PROTECTED TEST ACCOUNTS
    // =============================================================================
    
    function isTestAccount(userId) {
      return userId == 'IT8uvYQrbJPdhtelElWNaOTpG683' || // dispatcher@test.com
             userId == '0tTzE4twETWMNIbqubo58D9ulvf2' || // tech@test.com
             userId == '1k21kpBrsSV0ZLM1r6jPh6JAvCg2';   // solo@test.com
    }

    // =============================================================================
    // PLATFORM ADMIN CHECK
    // =============================================================================
    
    function isSiteAdmin() {
      return isSignedIn() && (
        request.auth.token.email == 'rich@richheaton.com' ||
        request.auth.token.site_admin == true
      );
    }

    // =============================================================================
    // ORGANIZATIONS COLLECTION
    // =============================================================================
    
    match /organizations/{orgId} {
      // Staff can read their own org
      allow read: if belongsToOrg(orgId);
      
      // Owners, admins, and dispatchers can update their own org (Settings page)
      allow update: if isSignedIn() && belongsToOrg(orgId) && isDispatcher();
      
      // Only Admin SDK (backend) can create or delete orgs
      allow create, delete: if false;

      // ─── EMAILS SUBCOLLECTION ───
      match /emails/{emailId} {
        allow read: if isSignedIn() && belongsToOrg(orgId);
        allow create: if isSignedIn() && belongsToOrg(orgId);
        allow update: if isSignedIn() && belongsToOrg(orgId);
        allow delete: if isSignedIn() && isAdmin() && belongsToOrg(orgId);
      }
    }

    // =============================================================================
    // USERS COLLECTION
    // =============================================================================
    
    match /users/{userId} {
      // Users can read their own profile always.
      // Staff can read other users in their same org.
      allow read: if isSignedIn() && (
        request.auth.uid == userId ||
        string(getOrgId()) == string(resource.data.org_id)
      );
      
      // Users can create their own profile (during signup)
      allow create: if isSignedIn() && request.auth.uid == userId;
      
      // Users can update their own profile.
      // Admins/dispatchers can update users in their org (role changes, etc.)
      allow update: if isSignedIn() && (
        request.auth.uid == userId ||
        (isDispatcher() && string(getOrgId()) == string(resource.data.org_id))
      );
      
      // Prevent deletion of test accounts; admins can delete others in their org
      allow delete: if isSignedIn() && isAdmin() && 
                       !isTestAccount(userId) && 
                       string(getOrgId()) == string(resource.data.org_id);
    }

    // =============================================================================
    // TECHNICIANS COLLECTION
    // =============================================================================
    
    match /technicians/{techId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && isAdmin() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg() && (isAdmin() || request.auth.uid == techId);
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // CUSTOMERS COLLECTION
    // =============================================================================
    
    match /customers/{customerId} {
      // Staff can read customers in their org
      // Customers can read their own record
      allow read: if (isSignedIn() && isStaff() && docBelongsToUserOrg()) ||
                     (isCustomer() && getCustomerId() == customerId);
      
      // Staff can create customers in their org
      allow create: if isSignedIn() && isStaff() && newDocHasUserOrg() && hasPermission('canAddCustomers');
      
      // Staff can update customers in their org
      // Customers can update their own preferences (limited fields)
      allow update: if (isSignedIn() && isStaff() && docBelongsToUserOrg()) ||
                      (isCustomer() && getCustomerId() == customerId);
      
      // Only admins can delete customers (GDPR deletion goes through backend)
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // JOBS COLLECTION
    // =============================================================================
    
    match /jobs/{jobId} {
      // Staff can read jobs in their org
      // Customers can read their own jobs
      allow read: if (isSignedIn() && isStaff() && docBelongsToUserOrg()) ||
                     (isCustomer() && resource.data.customer_id == getCustomerId());
      
      // Staff can create jobs in their org
      allow create: if isSignedIn() && isStaff() && newDocHasUserOrg();
      
      // Staff can update jobs in their org
      // Technicians can only update their assigned jobs
      allow update: if isSignedIn() && docBelongsToUserOrg() && (
        isDispatcher() || 
        isAdmin() || 
        (isTechnician() && resource.data.assigned_tech_id == request.auth.uid)
      );
      
      // Only admins and dispatchers can delete jobs
      allow delete: if isSignedIn() && (isAdmin() || isDispatcher()) && docBelongsToUserOrg();
    }

    // =============================================================================
    // TICKETS COLLECTION (Portal Inquiries)
    // =============================================================================
    
    match /tickets/{ticketId} {
      // Staff can read tickets in their org (tickets use 'organizationId' field)
      allow read: if isSignedIn() && docBelongsToUserOrgAlt();
      
      // Tickets can be created by staff in their org
      // Also allow unauthenticated/any-auth for portal submissions (backend creates these)
      allow create: if isSignedIn() && newDocHasUserOrgAlt();
      
      // Staff can update tickets (dismiss, convert to job, etc.)
      allow update: if isSignedIn() && docBelongsToUserOrgAlt();
      
      // Only admins can delete tickets
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrgAlt();
    }

    // =============================================================================
    // INTEGRATIONS SUBCOLLECTION
    // =============================================================================
    
    match /organizations/{orgId}/integrations/{integrationId} {
      // Staff can read integrations in their org
      allow read: if isSignedIn() && belongsToOrg(orgId);
      
      // Staff can create/update integrations
      allow create: if isSignedIn() && belongsToOrg(orgId);
      allow update: if isSignedIn() && belongsToOrg(orgId);
      
      // Only admins can delete
      allow delete: if isSignedIn() && isAdmin() && belongsToOrg(orgId);
    }

    // =============================================================================
    // IMPORTED TICKETS SUBCOLLECTION (Integrations)
    // =============================================================================
    
    match /organizations/{orgId}/importedTickets/{ticketId} {
      // Staff can read imported tickets in their org
      allow read: if isSignedIn() && belongsToOrg(orgId);
      
      // Staff can create/update imported tickets
      allow create: if isSignedIn() && belongsToOrg(orgId);
      allow update: if isSignedIn() && belongsToOrg(orgId);
      
      // Only admins can delete
      allow delete: if isSignedIn() && isAdmin() && belongsToOrg(orgId);
    }

    // =============================================================================
    // JOB SIGNATURES COLLECTION
    // =============================================================================
    
    match /job_signatures/{sigId} {
      // Staff can read signatures in their org
      allow read: if isSignedIn() && isStaff() && docBelongsToUserOrg();
      
      // Staff can create signatures in their org when completing jobs
      allow create: if isSignedIn() && isStaff() && newDocHasUserOrg();
      
      // Staff can update signatures in their org
      allow update: if isSignedIn() && isStaff() && docBelongsToUserOrg();
      
      // Only admins can delete signatures
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // INVOICES COLLECTION
    // =============================================================================
    
    match /invoices/{invoiceId} {
      // Staff can read invoices in their org
      // Customers can read their own invoices
      allow read: if (isSignedIn() && isStaff() && docBelongsToUserOrg()) ||
                     (isCustomer() && resource.data.customer_id == getCustomerId());
      
      // Staff can create/update invoices
      allow create: if isSignedIn() && isStaff() && newDocHasUserOrg();
      allow update: if isSignedIn() && isStaff() && docBelongsToUserOrg();
      
      // Only admins can delete invoices
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // COMMUNICATIONS COLLECTION
    // =============================================================================
    
    match /communications/{msgId} {
      // Staff can read all communications in their org
      // Customers can read their own communications
      allow read: if (isSignedIn() && isStaff() && docBelongsToUserOrg()) ||
                     (isCustomer() && resource.data.customer_id == getCustomerId());
      
      // Staff can create communications
      // Customers can create inbound messages only
      allow create: if (isSignedIn() && isStaff() && newDocHasUserOrg()) ||
                       (isCustomer() && 
                        request.resource.data.customer_id == getCustomerId() &&
                        request.resource.data.direction == 'inbound');
      
      // Staff can update communications (mark as read, etc.)
      allow update: if isSignedIn() && isStaff() && docBelongsToUserOrg();
      
      // Communications are never deleted directly (GDPR goes through backend)
      allow delete: if false;
    }

    // =============================================================================
    // ATTACHMENTS COLLECTION
    // =============================================================================
    
    match /attachments/{attachId} {
      // Staff can read attachments in their org
      // Customers can read their own attachments
      allow read: if (isSignedIn() && isStaff() && docBelongsToUserOrg()) ||
                     (isCustomer() && resource.data.customer_id == getCustomerId());
      
      // Staff can create attachments
      allow create: if isSignedIn() && isStaff() && newDocHasUserOrg();
      
      // Staff can update attachments
      allow update: if isSignedIn() && isStaff() && docBelongsToUserOrg();
      
      // Only admins can delete attachments
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // CONSENT RECORDS (GDPR)
    // =============================================================================
    
    match /consent_records/{recordId} {
      // Staff can read consents in their org
      // Customers can read their own consents
      allow read: if (isSignedIn() && isStaff() && docBelongsToUserOrg()) ||
                     (isCustomer() && resource.data.customer_id == getCustomerId());
      
      // Consents are only created/updated via backend
      allow write: if false;
    }

    // =============================================================================
    // AUDIT LOGS (GDPR)
    // =============================================================================
    
    match /audit_logs/{logId} {
      // Only admins can read audit logs
      allow read: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
      
      // Audit logs are only created via backend
      allow create: if false;
      
      // Audit logs are immutable
      allow update, delete: if false;
    }

    // =============================================================================
    // DATA EXPORT REQUESTS (GDPR)
    // =============================================================================
    
    match /data_export_requests/{requestId} {
      // Admins can read all export requests
      // Customers can read their own requests
      allow read: if (isSignedIn() && isAdmin() && docBelongsToUserOrg()) ||
                     (isCustomer() && resource.data.customer_id == getCustomerId());
      
      // Customers can request data export
      allow create: if isCustomer() && 
                       request.resource.data.customer_id == getCustomerId();
      
      // Only backend processes exports
      allow update, delete: if false;
    }

    // =============================================================================
    // ARCHIVED RECORDS
    // =============================================================================
    
    match /archived_records/{archiveId} {
      // Only admins can access archived records
      allow read: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
      
      // Archives are managed by backend
      allow write: if false;
    }

    // =============================================================================
    // QUOTES COLLECTION
    // =============================================================================
    
    match /quotes/{quoteId} {
      // Staff can read quotes in their org
      // Customers can read quotes for their jobs
      // Public can read quotes by direct ID (email "View Full Quote" link)
      // The quote document ID is unguessable and serves as an access token
      allow read: if true;
      
      // Staff can create quotes in their org
      allow create: if isSignedIn() && isStaff() && newDocHasUserOrg();
      
      // Staff can update any field on quotes in their org.
      // Unauthenticated users (customer email links) can only update approval/decline fields.
      allow update: if (isSignedIn() && isStaff() && docBelongsToUserOrg()) ||
                       request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'customerResponse', 'customerName', 'customerSignature',
                                   'approvedAt', 'declinedAt', 'viewedAt', 'viewCount', 'lastViewedAt',
                                   'depositPaidAt', 'depositAmount', 'stripePaymentIntentId']);
      
      // Only admins can delete quotes
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // MATERIALS/INVENTORY COLLECTION
    // =============================================================================
    
    match /materials/{materialId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg() && hasPermission('canPurchaseMaterials');
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && docBelongsToUserOrg() && hasPermission('canPurchaseMaterials');
    }

    // =============================================================================
    // INVENTORY TRANSACTIONS COLLECTION
    // =============================================================================
    
    match /inventory_transactions/{txnId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // TOOLS/EQUIPMENT COLLECTION
    // =============================================================================
    
    match /tools/{toolId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg() && hasPermission('canPurchaseTools');
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && docBelongsToUserOrg() && hasPermission('canPurchaseTools');
    }

    // =============================================================================
    // VENDORS COLLECTION
    // =============================================================================
    
    match /vendors/{vendorId} {
      // Vendors use 'organizationId' field
      allow read: if isSignedIn() && docBelongsToUserOrgAlt();
      allow create: if isSignedIn() && newDocHasUserOrgAlt() && hasPermission('canAddVendors');
      allow update: if isSignedIn() && docBelongsToUserOrgAlt() && hasPermission('canAddVendors');
      allow delete: if isSignedIn() && docBelongsToUserOrgAlt() && hasPermission('canAddVendors');
    }

    // =============================================================================
    // PURCHASE ORDERS COLLECTION
    // =============================================================================

    match /purchaseOrders/{poId} {
      // POs use 'organizationId' field
      allow read: if isSignedIn() && docBelongsToUserOrgAlt();
      allow create: if isSignedIn() && newDocHasUserOrgAlt() && hasPermission('canPurchaseMaterials');
      allow update: if isSignedIn() && docBelongsToUserOrgAlt() && hasPermission('canPurchaseMaterials');
      allow delete: if isSignedIn() && docBelongsToUserOrgAlt() && hasPermission('canPurchaseMaterials');
    }

    // =============================================================================
    // MASTER PURCHASE ORDERS (Grouped multi-vendor orders)
    // =============================================================================
    match /masterPurchaseOrders/{orderId} {
      // Master POs use 'organizationId' field
      allow read: if isSignedIn() && docBelongsToUserOrgAlt();
      allow create: if isSignedIn() && newDocHasUserOrgAlt();
      allow update: if isSignedIn() && docBelongsToUserOrgAlt();
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrgAlt();
    }

    // =============================================================================
    // RECEIVING RECORDS COLLECTION
    // =============================================================================
    match /receivingRecords/{recordId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // WAREHOUSE BINS COLLECTION
    // =============================================================================
    match /warehouseBins/{binId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // INVENTORY COUNTS COLLECTION
    // =============================================================================
    match /inventoryCounts/{countId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();

      match /lines/{lineId} {
        // Lines inherit parent's org scope
        allow read: if isSignedIn();
        allow create: if isSignedIn();
        allow update: if isSignedIn();
        allow delete: if isSignedIn();
      }
    }

    // =============================================================================
    // JOB PREP PACKAGES COLLECTION
    // =============================================================================
    match /jobPrepPackages/{packageId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // SCHEDULED REPORTS COLLECTION
    // =============================================================================
    match /scheduled_reports/{reportId} {
      // Uses 'organizationId' field
      allow read: if isSignedIn() && docBelongsToUserOrgAlt();
      allow create: if isSignedIn() && newDocHasUserOrgAlt();
      allow update: if isSignedIn() && docBelongsToUserOrgAlt();
      allow delete: if isSignedIn() && docBelongsToUserOrgAlt();
    }

    // =============================================================================
    // ASSETS COLLECTION (CRM)
    // =============================================================================
    match /assets/{assetId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // SCHEDULED MESSAGES COLLECTION (CRM)
    // =============================================================================
    match /scheduled_messages/{msgId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && docBelongsToUserOrg();
    }

    // =============================================================================
    // SITE CONFIG (Platform-wide)
    // =============================================================================
    match /site_config/{configId} {
      // Allow any staff to read configs
      allow read: if isSignedIn() && isStaff();
      // Only site admins can modify site config
      allow write: if isSiteAdmin();
    }

    // =============================================================================
    // BILLING HISTORY
    // =============================================================================
    match /billing_history/{document=**} {
      allow read: if isSiteAdmin();
      allow write: if false; // Only written by backend functions
    }

    // =============================================================================
    // SUPPORT ACCESS REQUESTS
    // =============================================================================
    match /support_access_requests/{requestId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && isAdmin() && docBelongsToUserOrg();
    }

    // =============================================================================
    // LEGACY COLLECTIONS
    // =============================================================================

    match /sent_emails/{emailId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
    }

    match /notifications/{notificationId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
    }

    match /appointment_reminders/{reminderId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && docBelongsToUserOrg();
    }

    match /customer_notes/{noteId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow write: if isSignedIn() && (
        (request.method == 'create' && newDocHasUserOrg()) ||
        (request.method != 'create' && docBelongsToUserOrg())
      );
    }

    match /mileage/{mileId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow write: if isSignedIn() && (
        (request.method == 'create' && newDocHasUserOrg()) ||
        (request.method != 'create' && docBelongsToUserOrg())
      );
    }

    match /reminders/{reminderId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow write: if isSignedIn() && (
        (request.method == 'create' && newDocHasUserOrg()) ||
        (request.method != 'create' && docBelongsToUserOrg())
      );
    }

    match /ai_voice_profiles/{profileId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow write: if isSignedIn() && docBelongsToUserOrg() && (isAdmin() || isSiteAdmin());
    }

    match /voice_sessions/{sessionId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow write: if isSignedIn() && docBelongsToUserOrg() && (isAdmin() || isSiteAdmin());
    }

    match /customer_questions/{questionId} {
      allow read: if isSignedIn() && belongsToOrg(resource.data.orgId);
      allow update: if isSignedIn() && belongsToOrg(resource.data.orgId);
      allow delete: if isSignedIn() && belongsToOrg(resource.data.orgId);
    }

    // =============================================================================
    // PENDING CALLBACKS (AI Voice Quote Callbacks)
    // =============================================================================
    match /pending_callbacks/{callbackId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && docBelongsToUserOrg();
    }

    // =============================================================================
    // SCHEDULED CALLBACKS (Retry / No-Speech Callbacks)
    // =============================================================================
    match /scheduled_callbacks/{callbackId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && docBelongsToUserOrg();
    }

    // =============================================================================
    // GLOBAL TAX RATES COLLECTION (Shared lookup data)
    // =============================================================================
    match /global_tax_rates/{rateId} {
      // Any authenticated user can read (shared reference data)
      allow read: if isSignedIn();
      // Only site admins or backend can write
      allow write: if isSiteAdmin();
    }

    // =============================================================================
    // PENDING FOLLOWUPS COLLECTION
    // =============================================================================
    match /pending_followups/{followupId} {
      allow read: if isSignedIn() && docBelongsToUserOrg();
      allow create: if isSignedIn() && newDocHasUserOrg();
      allow update: if isSignedIn() && docBelongsToUserOrg();
      allow delete: if isSignedIn() && docBelongsToUserOrg();
    }
  }
}
